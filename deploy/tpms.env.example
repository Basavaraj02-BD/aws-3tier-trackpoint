# Copy to /etc/tpms.env on the EC2 instance and fill in real values.
# Never commit the real file. No quotes, no spaces around "=".
DJANGO_SECRET_KEY=generate-with-python-secrets-token_urlsafe-50
DJANGO_DEBUG=0
ALLOWED_HOSTS=*
# CSRF_ORIGINS=http://your-alb-dns-name
DB_NAME=trackpoint
DB_USER=admin
DB_PASSWORD=your-rds-master-password
DB_HOST=your-db-endpoint.ap-south-1.rds.amazonaws.com
DB_PORT=3306
